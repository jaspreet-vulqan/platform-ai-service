# Copy to `.env` and edit. All values are optional unless noted.

# -------------------- Model / engine --------------------
# Which code-defined model profile to serve (see profiles.py; `python
# profiles.py list`). This is normally set by the systemd template instance
# (platform-ai-service@<key> -> MODEL_PROFILE=%i), not here. When set to a known
# key, the profile OVERRIDES the per-model vars below (MODEL, SERVED_MODEL_NAME,
# MAX_MODEL_LEN, ENFORCE_EAGER, TRUST_REMOTE_CODE, ENABLE_AUTO_TOOL_CHOICE,
# TOOL_CALL_PARSER, VLLM_EXTRA_ARGS). Everything else here (DTYPE, quant, gpu-mem,
# tensor-parallel, max-num-seqs, sampling, HTTP, backend, auth, HF) stays shared
# and is always read from this file. Set MODEL_PROFILE to `env` (or empty) to use
# the raw values below — the escape hatch for a one-off model not in the registry.
MODEL_PROFILE=
# HuggingFace id or local path of the model to serve.
# (Ignored unless MODEL_PROFILE is empty/env/custom — otherwise the profile wins.)
MODEL=Qwen/Qwen2.5-1.5B-Instruct
# Name advertised on /v1/models and accepted in the request "model" field.
# Defaults to MODEL if unset.
SERVED_MODEL_NAME=
# auto | half | bfloat16 | float16 | float32
DTYPE=auto
# Fraction of GPU memory vLLM may use (0-1). Lower if you hit OOM.
GPU_MEMORY_UTILIZATION=0.90
# Max context length. Leave empty/0 to use the model default.
MAX_MODEL_LEN=
# GPUs to shard across on a single node (>1 for large models).
TENSOR_PARALLEL_SIZE=1
# Max concurrently batched sequences.
MAX_NUM_SEQS=256
# awq | gptq | fp8 | bitsandbytes | (empty for none)
QUANTIZATION=
# Weight loader. MUST be "bitsandbytes" for pre-quantized bnb-4bit checkpoints
# (e.g. unsloth). Empty lets vLLM auto-pick.
LOAD_FORMAT=
# Disable CUDA graphs. Recommended true for bitsandbytes / first big-model load.
ENFORCE_EAGER=false
# Set true for models that require custom modelling code.
TRUST_REMOTE_CODE=false
# Optional explicit chat template (path or string). Empty = model's own.
CHAT_TEMPLATE=

# Tool / function calling (OpenAI-compatible).
ENABLE_AUTO_TOOL_CHOICE=false
# Required when ENABLE_AUTO_TOOL_CHOICE=true, e.g. llama3_json | hermes | mistral
TOOL_CALL_PARSER=
# Extra raw flags appended verbatim to `vllm serve` (space-separated). Escape
# hatch for flags the gateway doesn't model, e.g. reasoning control:
#   --reasoning-parser qwen3 --default-chat-template-kwargs '{"enable_thinking":false}'
# (Profile-managed for known models; single-quote any embedded JSON.)
VLLM_EXTRA_ARGS=

# -------------------- Sampling defaults --------------------
DEFAULT_MAX_TOKENS=1024
DEFAULT_TEMPERATURE=0.7

# -------------------- HTTP server (gateway) --------------------
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# -------------------- LLM backend (vllm serve) --------------------
# The gateway proxies to vLLM's own OpenAI server, run as a separate process.
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8001
# Defaults to http://BACKEND_HOST:BACKEND_PORT if left empty.
LLM_BACKEND_URL=
# true: this process launches & supervises `vllm serve` (one-command run).
# false: run vLLM as its own service and only proxy to LLM_BACKEND_URL.
MANAGE_BACKEND=true
# Optional key the backend itself requires (gateway -> backend). Usually empty.
BACKEND_API_KEY=
# Max seconds to wait for the model to load before failing startup.
BACKEND_STARTUP_TIMEOUT=1800
# Per-request timeout (seconds) for non-streaming backend calls.
REQUEST_TIMEOUT=600
# vLLM launcher executable.
VLLM_BIN=vllm

# -------------------- vLLM engine env (inherited by the vllm subprocess) --------------------
# Set here (NOT in the systemd unit) — load_dotenv() cannot override a systemd
# Environment=, so keeping them here makes .env the single source. On sm_120 /
# Blackwell with the CUDA-13 toolkit in place, FlashInfer can JIT its kernels;
# these remain as toggles if you hit a FlashInfer/attention-backend issue.
# Both are OFF by default (CUDA-13 toolkit lets FlashInfer JIT sm_120 kernels).
# Uncomment only if you hit a FlashInfer/attention issue. A bare "VAR=" exports
# an empty value and errors — keep them commented, don't leave them blank.
# VLLM_USE_FLASHINFER_SAMPLER=0            # disables the FlashInfer sampler
# VLLM_ATTENTION_BACKEND=TRITON_ATTN       # TRITON_ATTN | FLASH_ATTN | FLASHINFER

# -------------------- Auth / CORS --------------------
# Comma-separated keys accepted via "Authorization: Bearer <key>" or X-API-Key.
# REQUIRED in production. Empty disables auth (local dev only).
API_KEYS=
# Comma-separated allowed origins. Default "*".
CORS_ALLOW_ORIGINS=*
# Must be false when CORS_ALLOW_ORIGINS=*.
CORS_ALLOW_CREDENTIALS=false

# -------------------- HuggingFace --------------------
# Required for gated models (Llama, etc.).
HF_TOKEN=
# Optional ABSOLUTE path to cache weights (defaults to ~/.cache/huggingface).
# Empty is treated as unset; never use a relative path (HF would write to ./hub).
HF_HOME=

# ----------------------------------------------------------------------------
# Example: unsloth/gemma-4-31B-unsloth-bnb-4bit (multimodal, bnb 4-bit, 256K ctx)
# Copy these over the values above to serve it. Needs ~40GB+ VRAM (the vision/
# audio towers and embeddings stay in bf16). Single GPU recommended (TP=1).
# ----------------------------------------------------------------------------
# MODEL=unsloth/gemma-4-31B-unsloth-bnb-4bit
# DTYPE=bfloat16
# QUANTIZATION=bitsandbytes
# LOAD_FORMAT=bitsandbytes
# ENFORCE_EAGER=true
# MAX_MODEL_LEN=8192          # model max is 262144; cap it or the KV cache OOMs
# GPU_MEMORY_UTILIZATION=0.90
# TENSOR_PARALLEL_SIZE=1
# HF_TOKEN=hf_...             # required: Gemma is gated on HuggingFace

# ----------------------------------------------------------------------------
# Example: ibm-granite/granite-4.1-30b (DENSE transformer, 128K ctx, BF16, Apache-2.0)
# The easy case — no special flags, no HF token. Fits a single 96GB card
# (e.g. g7e.4xlarge = 1x RTX PRO 6000 Blackwell). For the full 128K context +
# more concurrency, switch MODEL to ibm-granite/granite-4.1-30b-fp8 (leave
# QUANTIZATION empty — vLLM auto-detects compressed-tensors FP8 — and raise
# MAX_MODEL_LEN to 131072).
# NOTE: on Blackwell (sm_120), install CUDA 12.8+ vLLM/torch wheels: pip install -U vllm
# ----------------------------------------------------------------------------
# MODEL=ibm-granite/granite-4.1-30b
# SERVED_MODEL_NAME=granite-4.1-30b
# DTYPE=bfloat16
# ENFORCE_EAGER=false
# MAX_MODEL_LEN=32768         # BF16-safe; raise toward 131072 with an FP8 build
# GPU_MEMORY_UTILIZATION=0.90
# TENSOR_PARALLEL_SIZE=1
# MAX_NUM_SEQS=32
